rules_version = '2';
// Live Firebase Storage rules. Publish with: python3 -I scripts/firestore-rules.py publish-storage storage.rules
service firebase.storage {
  match /b/{bucket}/o {
    function isGoogle() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Large map images (names are random UUIDs): anyone can load them, Google accounts add new ones
    // but nobody can replace an existing map
    match /maps/{mapId} {
      allow read: if true;
      allow create: if isGoogle() && resource == null
                    && request.resource.size < 20 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if isGoogle();
    }
    match /sound-effects/{fileId} {
      allow read: if true;
      allow create: if isGoogle() && resource == null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
      allow delete: if isGoogle();
    }
    // Spoken NPC voices: short clips made by the DM's browser, deleted soon after they're played
    match /npcAudio/{roomId}/{fileId} {
      allow read: if true;
      allow create, update: if isGoogle()
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
      allow delete: if isGoogle();
    }
  }
}
